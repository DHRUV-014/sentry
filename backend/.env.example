# Copy to backend/.env and fill in. Never commit .env.

# Server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Storage (SQLite). Audio is never stored.
DB_PATH=data/scamshield.db
# Store transcript text inside persisted events. false = text fields are redacted before writing.
STORE_TRANSCRIPTS=true

# Sessions
SESSION_IDLE_TIMEOUT_S=600
EVENT_QUEUE_SIZE=256
EVENT_REPLAY_SIZE=200

# LLM coercion tagger (later milestone)
LLM_ENABLED=false

# Telegram family alerts (B4). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_TIMEOUT_S=5
