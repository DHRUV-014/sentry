{
  "name": "scamshield-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-scamshield",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-scamshield 'node tests/firestore-rules.test.mjs'"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource/instrument-serif": "5.1.0",
    "firebase": "12.19.0",
    "lucide-react": "0.460.0",
    "motion": "12.23.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
