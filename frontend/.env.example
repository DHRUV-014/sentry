# Copy to frontend/.env and fill in. Never commit .env.
# Values come from Firebase console -> Project settings -> General -> Your apps -> Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development without a Firebase project: `npm run emulators` in another terminal, then set
#   VITE_FIREBASE_EMULATORS=true
#   VITE_FIREBASE_PROJECT_ID=demo-scamshield
#   VITE_FIREBASE_API_KEY=emulator   (any non-empty value; the emulator ignores it)
#   VITE_FIREBASE_AUTH_DOMAIN=localhost
#   VITE_FIREBASE_APP_ID=emulator
# Ports come from firebase.json.
VITE_FIREBASE_EMULATORS=false
